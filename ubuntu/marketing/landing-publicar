#!/bin/bash
# Publica una carpeta (con su index.html) como página de campaña, con dirección fija y
# visible aunque el móvil esté apagado.
#   landing-publicar ~/Descargas/Campañas/cafe/web  cafe-majadahonda
# Con Conexpix:  https://<tu-nombre>.conexpix.com/c/cafe-majadahonda/   (no hace falta nada más)
# Sin Conexpix:  https://<tu-usuario>.github.io/cafe-majadahonda/      (requisito: gh auth login)
# Para forzar GitHub aunque tengas Conexpix:  landing-publicar --github <carpeta> <nombre>
set -euo pipefail
GITHUB=0; [ "${1:-}" = --github ] && { GITHUB=1; shift; }
DIR="${1:?Uso: landing-publicar <carpeta> <nombre-corto-sin-espacios>}"
NOMBRE="${2:?Falta el nombre corto (ej. cafe-majadahonda)}"
if [ "$GITHUB" = 0 ] && [ -x "$HOME/.local/bin/conexpix" ] && [ -s "$HOME/.conexpix/token" ]; then
  exec "$HOME/.local/bin/conexpix" campana "$DIR" "$NOMBRE"
fi
NOMBRE="$(printf '%s' "$NOMBRE" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9-')"
[ -f "$DIR/index.html" ] || { echo "No hay index.html en $DIR"; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "Primero conecta GitHub:  gh auth login"; exit 1; }

USUARIO="$(gh api user -q .login)"
ID="$(gh api user -q .id)"
cd "$DIR"
[ -d .git ] || git init -q -b main
git config user.name >/dev/null || git config user.name "$USUARIO"
git config user.email >/dev/null || git config user.email "$ID+$USUARIO@users.noreply.github.com"
git add -A
git commit -qm "Actualizar web $(date +%F\ %H:%M)" || true

if gh repo view "$USUARIO/$NOMBRE" >/dev/null 2>&1; then
  git remote get-url origin >/dev/null 2>&1 || git remote add origin "https://github.com/$USUARIO/$NOMBRE.git"
  git push -q -u origin main
else
  gh repo create "$NOMBRE" --public --source . --push --description "Web publicada desde el móvil" >/dev/null
fi
gh api -X POST "repos/$USUARIO/$NOMBRE/pages" -f "source[branch]=main" -f "source[path]=/" >/dev/null 2>&1 || true

URL="https://$USUARIO.github.io/$NOMBRE/"
echo "Publicada: $URL"
echo "(La primera vez GitHub tarda 1-2 minutos en mostrarla.)"
