#!/usr/bin/env python3
"""OGG: copia los audios de WhatsApp a Descargas/Transcribir y los pasa a texto.

  OGG                los 5 últimos audios nuevos: copia + transcribe
  OGG 10             los 10 últimos
  OGG hoy            todos los de hoy        OGG 1h · OGG 30m · OGG 2d   (última hora, media hora, 2 días)
  OGG resumen        además, resumen con Claude de qué te piden y qué responder
  OGG enviados       incluye también los audios que has enviado tú
  OGG sin-texto      solo copiar, sin transcribir
  OGG otra-vez       vuelve a procesar audios ya copiados antes
Se pueden combinar:  OGG hoy resumen · OGG 3 otra-vez
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

W = "/storage/emulated/0/Android/media"
ORIGENES = {  # carpeta: prefijo para no mezclar nombres iguales
    f"{W}/com.whatsapp/WhatsApp/Media/WhatsApp Voice Notes": "WA",
    f"{W}/com.whatsapp/WhatsApp/Media/WhatsApp Audio": "WA",
    f"{W}/com.whatsapp.w4b/WhatsApp Business/Media/WhatsApp Business Voice Notes": "WAB",
    f"{W}/com.whatsapp.w4b/WhatsApp Business/Media/WhatsApp Business Audio": "WAB",
}
# Segundas cuentas de WhatsApp en el mismo móvil: .../accounts/<n>/Media/...
for _app, _dir, _pref in (("com.whatsapp", "WhatsApp", "WA"), ("com.whatsapp.w4b", "WhatsApp Business", "WAB")):
    try:
        _cuentas = os.listdir(f"{W}/{_app}/{_dir}/accounts")
    except OSError:
        _cuentas = []
    for _c in _cuentas:
        ORIGENES[f"{W}/{_app}/{_dir}/accounts/{_c}/Media/{_dir} Voice Notes"] = f"{_pref}{_c}"
        ORIGENES[f"{W}/{_app}/{_dir}/accounts/{_c}/Media/{_dir} Audio"] = f"{_pref}{_c}"
# Ruta de Android (no la de Ubuntu), para que el aviso a la galería funcione.
DESTINO = Path("/storage/emulated/0/Download/Ubuntu/Transcribir")
REGISTRO = Path.home() / ".local" / "share" / "ogg-transcribir" / "copiados.txt"
AUDIO = (".opus", ".ogg", ".m4a", ".mp3", ".aac", ".amr", ".wav")
STT = "https://api.elevenlabs.io/v1/speech-to-text"


def audios(enviados):
    for carpeta, prefijo in ORIGENES.items():
        try:
            nombres = os.listdir(carpeta)
        except OSError:
            continue
        # Notas de voz van por semanas (202644...): basta con las 2 últimas.
        semanas = sorted(n for n in nombres if n.isdigit())[-2:]
        sitios = [carpeta] + [f"{carpeta}/{s}" for s in semanas]
        if enviados:
            sitios.append(f"{carpeta}/Sent")
        for sitio in sitios:
            try:
                for e in os.scandir(sitio):  # no entra en Private/
                    if e.is_file() and e.name.lower().endswith(AUDIO):
                        yield e.stat().st_mtime, e.path, prefijo
            except OSError:
                pass


def clave_elevenlabs():
    if os.environ.get("ELEVENLABS_API_KEY"):
        return os.environ["ELEVENLABS_API_KEY"]
    try:
        k = json.load(open(Path.home() / ".config/marketing/config.json")).get("elevenlabs_key")
        if k:
            return k
    except (OSError, ValueError):
        pass
    try:
        return (Path.home() / ".config/elevenlabs/key").read_text().strip()
    except OSError:
        return None


def duracion(ruta):
    ff = shutil.which("ffprobe") or str(Path.home() / ".local/bin/ffprobe")
    try:
        out = subprocess.run([ff, "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", ruta],
                             capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=30).stdout
        s = int(float(out))
        return f"{s // 60}:{s % 60:02d}"
    except (OSError, ValueError, subprocess.SubprocessError):
        return "?"


def transcribir(ruta, clave):
    """Texto del audio con ElevenLabs Scribe; si hablan varias personas, separa por persona."""
    cmd = ["curl", "-s", "--max-time", "300", "-H", f"xi-api-key: {clave}",
           "--form-string", "model_id=scribe_v3", "--form-string", "diarize=true",
           "--form-string", "tag_audio_events=false", "-F", f"file=@{ruta}", STT]
    out = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL).stdout
    try:
        r = json.loads(out)
    except ValueError:
        return None, "sin respuesta del transcriptor (¿hay conexión?)"
    if "text" not in r:
        d = r.get("detail", r)
        return None, d.get("message", str(d)) if isinstance(d, dict) else str(d)
    palabras = [w for w in r.get("words", []) if w.get("type") != "audio_event"]
    hablantes = {w.get("speaker_id") for w in palabras if w.get("type") == "word"}
    if len(hablantes) <= 1:
        return r["text"].strip(), None
    nombres, lineas, actual, quien = {}, [], [], None
    for w in palabras:
        s = w.get("speaker_id")
        if w.get("type") == "word" and s != quien:
            if actual:
                lineas.append(f"{nombres[quien]}: {''.join(actual).strip()}")
            quien, actual = s, []
            nombres.setdefault(s, f"Persona {len(nombres) + 1}")
        actual.append(w["text"])
    if actual:
        lineas.append(f"{nombres[quien]}: {''.join(actual).strip()}")
    return "\n".join(lineas), None


def resumir(textos):
    claude = shutil.which("claude") or str(Path.home() / ".local/bin/claude")
    bloque = "\n\n".join(f"[{n} · {h} · {d}]\n{t}" for n, h, d, t in textos)
    prompt = ("Son notas de voz de WhatsApp que me han llegado. Para cada una, en español y en 1-3 líneas: "
              "quién parece ser o de qué va, qué me dice o me pide, y qué debería responder o hacer. "
              "Al final, una lista corta de tareas pendientes si las hay. Sin introducciones.\n\n" + bloque)
    try:
        r = subprocess.run([claude, "-p", prompt], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=300)
        return r.stdout.strip() or r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return f"No pude pedir el resumen a Claude: {e}"


def opciones(args):
    o = {"cuantos": 5, "desde": None, "resumen": False, "enviados": False, "texto": True, "repetir": False}
    for a in args:
        a = a.lower()
        if a.isdigit():
            o["cuantos"] = int(a)
        elif a == "hoy":
            o["desde"] = datetime.datetime.combine(datetime.date.today(), datetime.time()).timestamp()
        elif re.fullmatch(r"\d+[mhd]", a):
            n, u = int(a[:-1]), a[-1]
            o["desde"] = time.time() - n * {"m": 60, "h": 3600, "d": 86400}[u]
        elif a == "resumen":
            o["resumen"] = True
        elif a == "enviados":
            o["enviados"] = True
        elif a in ("sin-texto", "copiar"):
            o["texto"] = False
        elif a in ("otra-vez", "repetir"):
            o["repetir"] = True
        else:
            sys.exit(__doc__)
    return o


def main():
    o = opciones(sys.argv[1:])
    todos = sorted(audios(o["enviados"]), reverse=True)
    elegidos = [x for x in todos if x[0] >= o["desde"]][:50] if o["desde"] else todos[:o["cuantos"]]
    try:
        copiados = set(REGISTRO.read_text().splitlines())
    except OSError:
        copiados = set()
    pendientes = [x for x in elegidos if o["repetir"] or x[1] not in copiados]
    if not elegidos:
        print("No encontré audios de WhatsApp" + (" en ese plazo." if o["desde"] else "."))
        return
    if not pendientes:
        print(f"Los {len(elegidos)} audios ya se habían copiado antes. Usa  OGG otra-vez  para repetirlos.")
        return

    DESTINO.mkdir(parents=True, exist_ok=True)
    REGISTRO.parent.mkdir(parents=True, exist_ok=True)
    clave = clave_elevenlabs() if o["texto"] else None
    if o["texto"] and not clave:
        print("(Sin clave de ElevenLabs: solo copio. Configúrala con marketing-configurar para transcribir.)")
    textos = []
    for mtime, ruta, prefijo in reversed(pendientes):
        nombre = Path(ruta).name
        if nombre.endswith(".opus"):  # es Ogg; con .ogg lo abre cualquier transcriptor
            nombre = nombre[:-5] + ".ogg"
        final = DESTINO / f"{prefijo}_{nombre}"
        shutil.copy2(ruta, final)
        if ruta not in copiados:
            with REGISTRO.open("a") as f:
                f.write(ruta + "\n")
        subprocess.run(["am", "broadcast", "--user", "0", "-a",
                        "android.intent.action.MEDIA_SCANNER_SCAN_FILE", "-d", "file://" + str(final)],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30)
        hora = time.strftime("%d/%m %H:%M", time.localtime(mtime))
        dur = duracion(str(final))
        enviado = " · enviado" if "/Sent/" in ruta else ""
        print(f"\n▶ {final.name}  ({hora} · {dur}{enviado})")
        if clave:
            texto, error = transcribir(str(final), clave)
            if texto:
                final.with_suffix(".txt").write_text(texto + "\n")
                print(texto)
                textos.append((final.name, hora, dur, texto))
            else:
                print(f"  (no se pudo transcribir: {error})")
    print(f"\n{len(pendientes)} audio(s) en Descargas/Transcribir" + (" con su .txt" if textos else ""))

    if o["resumen"] and textos:
        print("\n── Resumen ──")
        res = resumir(textos)
        print(res)
        (DESTINO / f"resumen-{time.strftime('%Y%m%d-%H%M')}.txt").write_text(res + "\n")


if __name__ == "__main__":
    main()
